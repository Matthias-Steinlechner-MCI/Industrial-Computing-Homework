# Kopieren nach litellm/.env und ausfuellen. litellm/.env wird nicht committet.

# Google AI Studio -> Get API key
GEMINI_API_KEY=

# Beliebig, muss zu LITELLM_KEY in den .env-Dateien der Teile passen
LITELLM_MASTER_KEY=sk-1234
LITELLM_SALT_KEY=sk-salt-1234

# Nur Part 2 (Agent-Registry): Postgres-Datenbank "litellm"
DATABASE_URL=postgresql://postgres:<passwort>@localhost:5432/litellm

# Optional: Admin-UI auf http://localhost:4000/ui
UI_USERNAME=admin
UI_PASSWORD=sk-1234

# Optional: nur noetig, wenn ein Virenscanner oder Firmenproxy HTTPS aufbricht.
# Pfad zu einem PEM-Bundle, das dessen Wurzelzertifikat enthaelt.
SSL_CERT_FILE=
