# Lokaler LiteLLM-Proxy: LLM-Gateway UND Agent-Registry
LITELLM_URL=http://localhost:4000
LITELLM_KEY=sk-1234

# Jeder Agent laeuft auf einem eigenen Modell (Aliase aus LiteLLM/config.yaml).
# Das verteilt das Gemini-Free-Tier-Kontingent (20 Requests/Tag PRO Modell)
# und zeigt, dass A2A-Agenten mit unterschiedlichen LLMs zusammenarbeiten.
COORDINATOR_MODEL=gemini-3.5-flash,gpt-4o-mini,gemini-3-flash-preview,gemini-3.5-flash-lite
INVENTORY_MODEL=gemini-flash-lite-latest
QUOTE_MODEL=gemini-3.5-flash-lite
PLANNING_MODEL=gemini-3-flash-preview
# Rueckfall, falls eine der Variablen fehlt
AGENT_MODEL=gpt-4o-mini

# Wo die Agenten erreichbar sind (fuer Agent Card und Registrierung)
AGENT_HOST=localhost
INVENTORY_PORT=8101
QUOTE_PORT=8102
PLANNING_PORT=8103
